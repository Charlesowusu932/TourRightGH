# Prices per country live in lib/pricing.ts (US: US$15, UK: £11.99, everyone else: US$15).

# Where the buy buttons go. Defaults to the Selar product page.
NEXT_PUBLIC_CHECKOUT_URL=https://selar.com/k85pf8cz59
# Optional: a separate checkout link for UK visitors (e.g. a GBP-priced Selar product)
# CHECKOUT_URL_GB=
# Optional: force a country when testing locally, e.g. GB or US
# PRICING_COUNTRY=GB
# Public URL of the deployed site (used for social share images)
NEXT_PUBLIC_SITE_URL=https://example.com
# Google Tag Manager container (defaults to GTM-N3HLFRD8)
# NEXT_PUBLIC_GTM_ID=GTM-N3HLFRD8
# Meta Pixel (defaults to 1437236261447838)
# NEXT_PUBLIC_META_PIXEL_ID=1437236261447838
